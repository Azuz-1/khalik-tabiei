NODE_ENV=
PORT=
HOST=
SESSION_SECRET=
PUBLIC_ORIGIN=
ALLOWED_ORIGINS=
TRUST_PROXY=
DRAIN_TIMEOUT_MS=10000
EMPTY_LOBBY_EXPIRY_MS=1200000
MAX_MESSAGE_BYTES=8192
MAX_BUFFERED_BYTES=524288
MAX_SOCKETS_PER_IP=64
MAX_SOCKETS=4000

# --- Operational abuse limits -------------------------------------------------
# All optional. Every value falls back to the shipped shared-NAT-safe default
# when unset, zero, negative or non-numeric, so a typo cannot silently disable a
# shield. Windows are milliseconds. Defaults are shown in the comments.
#
# Coarse per-IP socket shield (default 300 per 60s) and the tighter per-signed-
# identity limit (default 60 per 60s). A house party puts Host + 10 phones behind
# one NAT with reconnect overlap, so the IP ceiling stays deliberately roomy.
RATE_LIMIT_CONNECTION_IP_LIMIT=
RATE_LIMIT_CONNECTION_IP_WINDOW_MS=
RATE_LIMIT_CONNECTION_IDENTITY_LIMIT=
RATE_LIMIT_CONNECTION_IDENTITY_WINDOW_MS=

# Session issuance: per IP (default 300 per 60s), per identity (default 120 per 60s).
RATE_LIMIT_SESSION_IP_LIMIT=
RATE_LIMIT_SESSION_IP_WINDOW_MS=
RATE_LIMIT_SESSION_IDENTITY_LIMIT=
RATE_LIMIT_SESSION_IDENTITY_WINDOW_MS=

# Room creation: per IP (default 36 per 60s), per identity (default 3 per 60s).
RATE_LIMIT_ROOM_CREATION_IP_LIMIT=
RATE_LIMIT_ROOM_CREATION_IP_WINDOW_MS=
RATE_LIMIT_ROOM_CREATION_IDENTITY_LIMIT=
RATE_LIMIT_ROOM_CREATION_IDENTITY_WINDOW_MS=

# Bound on tracked keys per limiter (default 20000) and the sweep interval
# (default 60000ms) that reclaims expired buckets.
RATE_LIMIT_MAX_TRACKED_KEYS=
RATE_LIMIT_CLEANUP_INTERVAL_MS=

# --- Request idempotency cache ------------------------------------------------
# How long a completed request id stays replayable (default 300000ms) and how
# many ids are retained per signed identity (default 128, oldest evicted first).
REQUEST_RETENTION_MS=
MAX_REQUESTS_PER_UID=
